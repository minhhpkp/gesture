name: "pose"
backend: "python"

max_batch_size: 0

input [
  {
    name: "IMAGES"
    data_type: TYPE_UINT8
    dims: [ -1, -1, -1, 3 ]  # B, H, W, 3
  },
  {
    name: "BBOXES"
    data_type: TYPE_FP32
    dims: [ -1, 4 ]          # N, 4
  },
  {
    name: "BBOX_COUNTS"
    data_type: TYPE_INT32
    dims: [ -1 ]             # B
  }
]
output [
  {
    name: "KEYPOINTS"
    data_type: TYPE_FP32
    dims: [ -1, -1, 3 ]  # N, K, 3
  }
]

instance_group [{ kind: KIND_GPU }]

parameters {
  key: "EXECUTION_ENV_PATH"
  value { string_value: "/work/gesture/src/triton/environments/mmdeploy_runtime" }
}