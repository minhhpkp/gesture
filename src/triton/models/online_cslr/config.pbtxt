name: "online_cslr"
backend: "python"

max_batch_size: 16

input [
  {
    name: "CLIP"
    data_type: TYPE_UINT8
    dims: [ 3, -1, -1, -1 ]  # 3, T, H, W - BGR
  },
  {
    name: "KEYPOINTS"
    data_type: TYPE_FP32
    dims: [ -1, -1, 3 ]      # T, K, 3
  }
]
output [
  {
    name: "GLOSS"            # gloss probabilities
    data_type: TYPE_FP32
    dims: [ 1116 ]
  }
]

instance_group [{ kind: KIND_GPU }]

model_warmup [
  {
    name: "random1"
    batch_size: 1
    inputs {
      key: "CLIP"
      value {
        data_type: TYPE_UINT8
        dims: [3, 16, 224, 224]
        random_data: true
      }
    }
    inputs {
      key: "KEYPOINTS"
      value {
        data_type: TYPE_FP32
        dims: [ 16, 63, 3 ]
        random_data: true
      }
    }
    count: 5
  },
  {
    name: "random4"
    batch_size: 4
    inputs {
      key: "CLIP"
      value {
        data_type: TYPE_UINT8
        dims: [3, 16, 224, 224]
        random_data: true
      }
    }
    inputs {
      key: "KEYPOINTS"
      value {
        data_type: TYPE_FP32
        dims: [ 16, 63, 3 ]
        random_data: true
      }
    }
    count: 5
  },
  {
    name: "random8"
    batch_size: 8
    inputs {
      key: "CLIP"
      value {
        data_type: TYPE_UINT8
        dims: [3, 16, 224, 224]
        random_data: true
      }
    }
    inputs {
      key: "KEYPOINTS"
      value {
        data_type: TYPE_FP32
        dims: [ 16, 63, 3 ]
        random_data: true
      }
    }
    count: 5
  },
  {
    name: "random16"
    batch_size: 16
    inputs {
      key: "CLIP"
      value {
        data_type: TYPE_UINT8
        dims: [3, 16, 224, 224]
        random_data: true
      }
    }
    inputs {
      key: "KEYPOINTS"
      value {
        data_type: TYPE_FP32
        dims: [ 16, 63, 3 ]
        random_data: true
      }
    }
    count: 5
  }
]

parameters {
    key: "cslr_config"
    value { string_value: "triton_cslr_phoenix-2014t.yaml" }
}

parameters {
  key: "EXECUTION_ENV_PATH"
  value { string_value: "/work/environments/online_cslr.tar.gz" }
}
