name: "online_cslr"
backend: "python"

max_batch_size: 16

input [
  {
    name: "CLIP"
    data_type: TYPE_UINT8
    dims: [ -1, 3, -1, -1 ]  # T, 3, H, W RGB
  },
  {
    name: "KEYPOINTS",
    data_type: TYPE_FP32,
    dims: [ -1, -1, 3 ]      # T, K, 3
  }
]
output [
  {
    name: "GLOSS"            # gloss probabilities
    data_type: TYPE_FP32
    dims: [ 1116 ]
  }
]

instance_group [{ kind: KIND_GPU }]

parameters {
    key: "cslr_config"
    value { string_value: "triton_cslr_phoenix-2014t.yaml" }
}

parameters {
  key: "EXECUTION_ENV_PATH"
  value { string_value: "/work/gesture/src/triton/environments/online_cslr" }
}